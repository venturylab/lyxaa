# Leave unset for the protected preview. Set to true only at public launch.
# SITE_INDEXABLE=true

# Optional origin for absolute Open Graph URLs. Leave empty until a domain exists.
# NEXT_PUBLIC_SITE_URL=

# Booking stays in preview mode until one of these providers is set.
# The route then validates and forwards. It stores nothing locally.
# BOOKING_WEBHOOK_URL=https://example.com/hooks/booking
# RESEND_API_KEY=
# BOOKING_FROM_EMAIL="Booking <booking@example.com>"
# BOOKING_TO_EMAIL=booking@example.com
